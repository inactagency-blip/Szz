# Copy this file to .env and fill in your own values. Never commit .env.

PORT=4000

# Any long random string — this is the password for /admin and the admin API.
# Example of generating one: run  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=change-this-to-a-long-random-string

# The exact URL your website is hosted at, e.g. https://inactagency.co.za
# Use * only while testing locally — lock it down before going live.
ALLOWED_ORIGIN=*

# --- Get an email the moment someone submits the intake form ---
# GMAIL_USER: the Gmail address to send FROM (can be inactagency@gmail.com)
# GMAIL_APP_PASSWORD: NOT your normal Gmail password — a 16-character "app
#   password". See backend/README.md → "Get notified the moment someone
#   books a call" for how to generate one.
# NOTIFY_TO: where the notification is sent (defaults to GMAIL_USER if blank)
GMAIL_USER=inactagency@gmail.com
GMAIL_APP_PASSWORD=
NOTIFY_TO=inactagency@gmail.com
